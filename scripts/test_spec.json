{
  "stages": {
    "fmt": true,
    "check": true,
    "test": true,
    "build": true,
    "run": true
  },
  "apps": [
    {
      "path": "examples/bytes-stdin-stdout.roc",
      "cases": [
        {
          "name": "happy",
          "stdin": "someinput\n",
          "stdout_contains": ["someinput\n"],
          "stderr_contains": ["Copied 10 bytes from stdin to stdout."]
        },
        {
          "name": "no-input",
          "stderr_contains": ["Copied 0 bytes from stdin to stdout."]
        }
      ]
    },
    {
      "path": "examples/check-command.roc",
      "platforms": { "windows": { "run": false } },
      "reason": "Checks a Unix command is on the PATH",
      "cases": [
        {
          "name": "happy",
          "contains": [
            "sh is available",
            "definitely-not-a-real-command-xyz is not available"
          ]
        }
      ]
    },
    {
      "path": "examples/command-line-args.roc",
      "cases": [
        {
          "name": "one-argument",
          "args": ["foo"],
          "contains": [
            "program name:",
            "verbose: False",
            "received argument: foo",
            "back to OsStr: OsStr.",
            "argument 1 is valid UTF-8: foo"
          ],
          "regex": [
            "program name: .*command-line-args(?:\\.exe)?",
            "(?:Unix argument, bytes|Windows argument, UTF-16 code units): \\[102, 111, 111\\]"
          ]
        },
        {
          "name": "literal-equals-native-argument",
          "args": ["foo", "--verbose"],
          "contains": ["verbose: True", "received argument: foo"]
        },
        {
          "name": "literal-differs-from-similar-argument",
          "args": ["--verbos", "--verbose=1", "--VERBOSE"],
          "contains": ["verbose: False", "received argument: --verbos"]
        },
        {
          "name": "missing-argument",
          "exit_code": 1,
          "contains": ["verbose: False", "Program exited with error: MissingArgument"]
        }
      ]
    },
    {
      "path": "examples/command.roc",
      "platforms": { "windows": { "run": false } },
      "reason": "Runtime scenario invokes Unix commands",
      "cases": [
        {
          "name": "happy",
          "contains": ["Hello", "Command config: Cmd({", "Exit code: 1", "stdout_bytes: [72, 105, 10]"]
        }
      ]
    },
    {
      "path": "examples/dir.roc",
      "cases": [
        {
          "name": "workspace-lifecycle",
          "temp_cwd": true,
          "contains": ["Workspace entries:", "Workspace cleaned up."]
        }
      ]
    },
    {
      "path": "examples/env-var.roc",
      "cases": [
        {
          "name": "both-variables",
          "env": { "EDITOR": "nano", "LETTERS": "a,c,e,j" },
          "contains": [
            "Your favorite editor is nano!",
            "No need to remember how to quit vim.",
            "Your favorite letters are: a c e j",
            "The environment dictionary agrees: a,c,e,j"
          ]
        },
        {
          "name": "literal-equals-native-value",
          "env": { "EDITOR": "vim", "LETTERS": "x" },
          "contains": [
            "Your favorite editor is vim!",
            "Remember: `:q!` gets you out.",
            "The environment dictionary agrees: x"
          ]
        },
        {
          "name": "missing-editor",
          "unset_env": ["EDITOR", "LETTERS"],
          "exit_code": 1,
          "contains": ["VarNotFound(OsStr."]
        },
        {
          "name": "missing-letters",
          "unset_env": ["LETTERS"],
          "env": { "EDITOR": "nano" },
          "exit_code": 1,
          "contains": ["VarNotFound(OsStr."]
        }
      ]
    },
